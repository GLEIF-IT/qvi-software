# Nonsecret documentation only. vlei-workflow.sh generates a private mode-0600
# Compose environment file for every run; do not copy real values here.
WORKFLOW_CONFIG_DIR=/tmp/qvi-workflow/config
WORKFLOW_PROOF_DIR=/tmp/qvi-workflow/proof
WORKFLOW_SECRET_DIR=/tmp/qvi-workflow/secrets
KEYSTORE_DIR=/tmp/qvi-workflow/keystores
KLI_DATA_DIR=/tmp/qvi-workflow/acdc-info
LOCAL_QVI_DATA_DIR=/tmp/qvi-workflow/qvi-data
WORKFLOW_UID=1000
WORKFLOW_GID=1000
WORKFLOW_TIMEOUT_SECONDS=120
DIRECT_SALLY_KS_NAME=example-direct-sally
DIRECT_SALLY_ALIAS=example-direct-sally
DIRECT_SALLY_PRE=EXAMPLE_PREFIX
DIRECT_SALLY_SALT=GENERATED_AT_RUNTIME
DIRECT_SALLY_PASSCODE=GENERATED_AT_RUNTIME
WEBHOOK_HOST=http://hook:9923
GEDA_PRE=GENERATED_AT_RUNTIME
